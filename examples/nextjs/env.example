# Peach Payments — Next.js Example Environment Configuration
# Copy this file to .env.local and fill in your credentials from Peach Dashboard.
# NEVER commit .env.local or expose secret keys to client-side code.

PEACH_ENV=sandbox

# Checkout V2 (OAuth) credentials — from Dashboard → Checkout → API keys
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_SECRET_TOKEN=

# Webhook signing (Dashboard → Webhook security header scheme)
PEACH_WEBHOOK_SECRET=
PEACH_WEBHOOK_URL=http://localhost:3000/api/webhook

# Peach Endpoints (Sandbox defaults)
PEACH_AUTH_HOST=https://sandbox-dashboard.peachpayments.com
PEACH_CHECKOUT_HOST=https://testsecure.peachpayments.com
PEACH_CARD_HOST=https://sandbox-card.peachpayments.com

# Currency (ZAR, KES, MUR, USD, GBP, EUR)
PEACH_CURRENCY=ZAR

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
