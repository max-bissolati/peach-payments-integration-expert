# Peach Payments — PHP Reference Environment
PEACH_ENV=sandbox
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_SECRET_TOKEN=

# Webhook signing (Dashboard -> Webhook security)
PEACH_WEBHOOK_SECRET=
PEACH_WEBHOOK_URL=http://localhost:8000/webhook.php

# Peach Hosts (defaults to sandbox)
PEACH_AUTH_HOST=https://sandbox-dashboard.peachpayments.com
PEACH_CHECKOUT_HOST=https://testsecure.peachpayments.com
PEACH_CARD_HOST=https://sandbox-card.peachpayments.com

PORT=8000
APP_URL=http://localhost:8000
PEACH_CURRENCY=ZAR
