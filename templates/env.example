# Peach Payments — environment template
# Copy to `.env` (server-side only) and fill from your Peach Dashboard. NEVER commit real values,
# and NEVER put secrets in client/browser code — only PEACH_ENTITY_ID is safe on the frontend.
# Start in sandbox. Going live = swapping the *_HOST values + the credentials, nothing else.
# Rename to `.env.example` if your tooling expects the dotfile name.

# ── Which environment (flip this, not the code) ─────────────────────────────
PEACH_ENV=sandbox                     # sandbox | live

# ── Checkout V2 (OAuth) credentials — from Dashboard → Checkout → API keys ──
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=                  # SERVER-SIDE ONLY
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=                      # channel/entity id — doubles as the browser SDK `key` (semi-public)
PEACH_SECRET_TOKEN=                   # signs classic webhooks + V1 refunds — SERVER-SIDE ONLY

# ── Webhook signing (if you enabled the header scheme in the Dashboard) ─────
PEACH_WEBHOOK_SECRET=                 # header-scheme shared secret — SERVER-SIDE ONLY
PEACH_WEBHOOK_URL=                    # the EXACT URL you configured (used in the header-scheme message)

# ── Hosts — sandbox values shown; for live, use the right-hand column ────────
#   OAuth token:  sandbox-dashboard.peachpayments.com   → dashboard.peachpayments.com
#   Checkout API: testsecure.peachpayments.com          → secure.peachpayments.com
#   Card facade (tokenisation / MIT debits / capture): sandbox-card.peachpayments.com → card.peachpayments.com
PEACH_AUTH_HOST=https://sandbox-dashboard.peachpayments.com
PEACH_CHECKOUT_HOST=https://testsecure.peachpayments.com
PEACH_CARD_HOST=https://sandbox-card.peachpayments.com

# ── Recurring / MIT (only if you tokenise + charge saved cards) ─────────────
# The MIT debit call uses the SERVER-TO-SERVER / recurring token, NOT the Checkout OAuth token above.
PEACH_RECURRING_ENTITY_ID=
PEACH_RECURRING_TOKEN=                # SERVER-SIDE ONLY

# ── Payouts (only if you disburse funds) — amounts are in INTEGER CENTS here ─
PEACH_PAYOUTS_HOST=https://sandbox-payouts.peachpayments.com
PEACH_PAYOUTS_CLIENT_ID=
PEACH_PAYOUTS_CLIENT_SECRET=          # SERVER-SIDE ONLY
